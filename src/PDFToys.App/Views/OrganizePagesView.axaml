<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" xmlns:views="using:PDFToys.App.Views" xmlns:models="using:PDFToys.App.Models"
             x:Class="PDFToys.App.Views.OrganizePagesView" x:DataType="vm:OrganizePagesViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
            <Button Content="← Home" Command="{Binding GoBackCommand}" Classes="back" />
            <StackPanel Spacing="6">
                <TextBlock Text="Organize pages" Classes="toolTitle" />
                <TextBlock Text="Reorder, rotate or exclude pages, then save a new PDF. Preview includes your pending rotation." Classes="helper" />
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Input PDF" Classes="sectionTitle" />
                <Button Content="Choose / change PDF" Command="{Binding SelectPdfCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding SelectedFileLabel}" Classes="helper" />
                <TextBlock Text="Pages" Classes="sectionTitle" Margin="0,8,0,0" />
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="Pages to organize">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:OrganizePageItemViewModel">
                        <WrapPanel Margin="2,5">
                            <TextBlock Text="{Binding DisplayPosition, StringFormat='Position {0}'}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding SourcePageNumber, StringFormat='Source page {0}'}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding RotationLabel}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding IncludedLabel, StringFormat='Included: {0}'}" />
                        </WrapPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel>
                    <Button Content="Move up" Command="{Binding MoveUpCommand}" Margin="0,0,8,8" />
                    <Button Content="Move down" Command="{Binding MoveDownCommand}" Margin="0,0,8,8" />
                    <Button Content="Rotate left" Command="{Binding RotateLeftCommand}" Margin="0,0,8,8" />
                    <Button Content="Rotate right" Command="{Binding RotateRightCommand}" Margin="0,0,8,8" />
                    <Button Content="Preview" Command="{Binding ViewPageCommand}" Margin="0,0,8,8" />
                    <Button Content="Exclude" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
                    <Button Content="Restore" Command="{Binding RestoreCommand}" Margin="0,0,8,8" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="Output" Classes="sectionTitle" />
                <TextBlock Text="{Binding SavedAsLabel}" Classes="helper" />
                <Button Content="Choose save location" Command="{Binding ChooseOutputCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="Saving creates a separate file. If the chosen name exists, a unique name is used." Classes="helper" />
            </StackPanel>
            <Button Content="Save organized PDF" Command="{Binding SaveCommand}" Classes="primary" HorizontalAlignment="Left" />
            <views:OperationResultsView />
        </StackPanel>
    </ScrollViewer>
</UserControl>
