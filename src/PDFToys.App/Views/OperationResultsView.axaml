<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" x:Class="PDFToys.App.Views.OperationResultsView" x:DataType="vm:OperationViewModelBase">
    <StackPanel Spacing="12" Margin="0,4,0,8">
        <Border Classes="statusCard" Padding="14">
            <StackPanel Spacing="10">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding ProgressText}" Classes="helper" IsVisible="{Binding IsBusy}" />
                <WrapPanel>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,8,0" />
                    <Button Content="Retry failed" Command="{Binding RetryFailedCommand}" IsVisible="{Binding CanRetry}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="Results" Classes="sectionTitle" IsVisible="{Binding HasResults}" />
        <ItemsControl ItemsSource="{Binding Results}" IsVisible="{Binding HasResults}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationResultItemViewModel">
                    <Border Classes="resultCard" Padding="14" Margin="0,0,0,10">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding OutcomeLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InputPath, StringFormat='Input: {0}'}" Classes="helper" />
                            <TextBlock Text="{Binding Details}" Classes="helper" />
                            <TextBlock Text="{Binding Path}" Classes="helper" IsVisible="{Binding HasOutput}" />
                            <WrapPanel IsVisible="{Binding HasOutput}">
                                <Button Content="Open" Command="{Binding OpenCommand}" Margin="0,0,8,6" />
                                <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}" Margin="0,0,8,6" />
                                <Button Content="Copy path" Command="{Binding CopyPathCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
