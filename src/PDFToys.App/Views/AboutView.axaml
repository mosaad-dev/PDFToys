<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" x:Class="PDFToys.App.Views.AboutView" x:DataType="vm:AboutViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16" MaxWidth="880">
            <Button Content="← Home" Command="{Binding GoBackCommand}" Classes="back" />
            <TextBlock Text="{Binding Title}" Classes="toolTitle" />
            <TextBlock Text="{Binding VersionText, StringFormat='Version {0}'}" Classes="helper" />
            <TextBlock Text="{Binding LicenseSummary}" TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="License" Command="{Binding OpenLicenseCommand}" IsEnabled="{Binding IsLicenseAvailable}" Margin="0,0,8,8" />
                <Button Content="Third-party notices" Command="{Binding OpenNoticesCommand}" IsEnabled="{Binding AreNoticesAvailable}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
