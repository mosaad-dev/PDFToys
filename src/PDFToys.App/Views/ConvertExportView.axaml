<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" xmlns:views="using:PDFToys.App.Views" xmlns:models="using:PDFToys.App.Models"
             x:Class="PDFToys.App.Views.ConvertExportView" x:DataType="vm:ConvertExportViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
            <Button Content="← Home" Command="{Binding GoBackCommand}" Classes="back" />
            <StackPanel Spacing="6">
                <TextBlock Text="Convert / Export" Classes="toolTitle" />
                <TextBlock Text="Convert documents and images to PDF, or export PDF pages and text. Office formats require installed Word, Excel or PowerPoint." Classes="helper" />
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Operation" Classes="sectionTitle" />
                <ComboBox ItemsSource="{Binding OperationItems}" SelectedItem="{Binding SelectedOperationItem}" AutomationProperties.Name="Conversion operation">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:ConvertExportOperationItem"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Input files" Classes="sectionTitle" />
                <Button Content="{Binding AddFilesButtonLabel}" Command="{Binding AddFilesCommand}" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding SelectedFiles}" AutomationProperties.Name="Selected files">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PdfFileItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,4">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FullPath}" Classes="helper" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Remove" Command="{Binding $parent[UserControl].DataContext.RemoveFileCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <TextBlock Text="Output: new files beside each input. Combined PDFs are saved beside the first input. Markdown extracts text and does not reproduce page layout." Classes="helper" />
            <Button Content="Run conversion / export" Command="{Binding ExecuteCommand}" Classes="primary" HorizontalAlignment="Left" />
            <views:OperationResultsView />
        </StackPanel>
    </ScrollViewer>
</UserControl>
