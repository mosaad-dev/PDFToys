<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" xmlns:views="using:PDFToys.App.Views" xmlns:models="using:PDFToys.App.Models"
             x:Class="PDFToys.App.Views.CompressView" x:DataType="vm:CompressViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
            <Button Content="← Home" Command="{Binding GoBackCommand}" Classes="back" />
            <StackPanel Spacing="6">
                <TextBlock Text="Compress PDF" Classes="toolTitle" />
                <TextBlock Text="Reduce supported embedded images with lossy recompression. Text and vector content stay sharp; protected or unsupported images are preserved." Classes="helper" />
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Input files" Classes="sectionTitle" />
                <Button Content="Add PDF files" Command="{Binding AddFilesCommand}" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding SelectedFiles}" AutomationProperties.Name="Selected files">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PdfFileItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,4">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FullPath}" Classes="helper" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Remove" Command="{Binding $parent[UserControl].DataContext.RemoveFileCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Image quality" Classes="sectionTitle" />
                <ComboBox ItemsSource="{Binding CompressionLevels}" SelectedItem="{Binding SelectedCompressionLevel}" AutomationProperties.Name="Compression quality" />
                <TextBlock Text="Standard keeps more image detail. Maximum trades image quality for smaller files. Size reduction depends on the PDF." Classes="helper" />
                <TextBlock Text="Output" Classes="sectionTitle" Margin="0,8,0,0" />
                <TextBlock Text="A new copy beside each original. Already optimized or unsupported PDFs may remain the same size. Existing files keep their names and content." Classes="helper" />
            </StackPanel>
            <Button Content="Compress files" Command="{Binding ExecuteCompressCommand}" Classes="primary" HorizontalAlignment="Left" />
            <views:OperationResultsView />
        </StackPanel>
    </ScrollViewer>
</UserControl>
