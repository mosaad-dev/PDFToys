<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" xmlns:views="using:PDFToys.App.Views" xmlns:models="using:PDFToys.App.Models"
             x:Class="PDFToys.App.Views.MergeView" x:DataType="vm:MergeViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
            <Button Content="← Home" Command="{Binding GoBackCommand}" Classes="back" />
            <StackPanel Spacing="6">
                <TextBlock Text="Merge PDFs" Classes="toolTitle" />
                <TextBlock Text="Combine PDFs in the order below. Select a file and use Move up / down, or drag it to another position." Classes="helper" />
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Input files, in order" Classes="sectionTitle" />
                <Button Content="Add PDF files" Command="{Binding AddFilesCommand}" HorizontalAlignment="Left" />
                <ListBox x:Name="MergeItemsListBox" ItemsSource="{Binding MergeItems}" SelectedItem="{Binding SelectedItem}" DragDrop.AllowDrop="True" AutomationProperties.Name="PDF merge order">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:MergeItem">
                        <StackPanel Spacing="3" Margin="2,4">
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FullPath}" Classes="helper" />
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel>
                    <Button Content="Move up" Command="{Binding MoveUpCommand}" Margin="0,0,8,8" />
                    <Button Content="Move down" Command="{Binding MoveDownCommand}" Margin="0,0,8,8" />
                    <Button Content="Remove selected" Command="{Binding RemoveFileCommand}" Margin="0,0,0,8" />
                </WrapPanel>
            </StackPanel>
            <TextBlock Text="Output: a new merged PDF beside the inputs. Files from different folders prompt for a save location." Classes="helper" />
            <Button Content="Merge files" Command="{Binding ExecuteMergeCommand}" Classes="primary" HorizontalAlignment="Left" />
            <views:OperationResultsView />
        </StackPanel>
    </ScrollViewer>
</UserControl>
