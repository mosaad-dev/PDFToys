<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" xmlns:views="using:PDFToys.App.Views" xmlns:models="using:PDFToys.App.Models"
             x:Class="PDFToys.App.Views.SplitView" x:DataType="vm:SplitViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
            <Button Content="← Home" Command="{Binding GoBackCommand}" Classes="back" />
            <StackPanel Spacing="6">
                <TextBlock Text="Split PDF" Classes="toolTitle" />
                <TextBlock Text="Create separate PDFs from page ranges. Each comma-separated range becomes its own file." Classes="helper" />
            </StackPanel>
            <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Input PDF" Classes="sectionTitle" />
                <Button Content="Choose / change PDF" Command="{Binding SelectPdfCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding SelectedFileLabel}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PageCountLabel}" Classes="helper" />
                <TextBlock Text="Quick split" Classes="sectionTitle" Margin="0,8,0,0" />
                <WrapPanel>
                    <Button Content="Split in half" Command="{Binding SplitPresetCommand}" CommandParameter="half" Margin="0,0,8,8" />
                    <Button Content="Split into 4" Command="{Binding SplitPresetCommand}" CommandParameter="quarter" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="Custom page ranges" Classes="sectionTitle" />
                <TextBox Text="{Binding CustomRangeText}" PlaceholderText="1-5, 8, 11-13" AutomationProperties.Name="Page ranges" />
                <TextBlock Text="Page numbers start at 1. Example: 1-5, 8 creates two files. New files are saved beside the original." Classes="helper" />
            </StackPanel>
            <Button Content="Split page ranges" Command="{Binding ExecuteCustomSplitCommand}" Classes="primary" HorizontalAlignment="Left" />
            <views:OperationResultsView />
        </StackPanel>
    </ScrollViewer>
</UserControl>
