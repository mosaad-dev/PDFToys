<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels" x:Class="PDFToys.App.Views.HomeView" x:DataType="vm:HomeViewModel">
    <UserControl.Styles>
        <Style Selector="Button.toolCard"><Setter Property="Width" Value="296" /><Setter Property="MinHeight" Value="100" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="Padding" Value="18" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12" MaxWidth="920">
            <TextBlock Text="PDFToys" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Everyday PDF tools, right on your desktop." Classes="helper" Margin="0,0,0,12" />
            <WrapPanel HorizontalAlignment="Left">
                <Button Classes="toolCard" Command="{Binding GoToMergeCommand}"><StackPanel Spacing="7"><TextBlock Text="Merge PDFs" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Bring documents together in order." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToSplitCommand}"><StackPanel Spacing="7"><TextBlock Text="Split PDF" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Separate pages into new files." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToCompressCommand}"><StackPanel Spacing="7"><TextBlock Text="Compress PDF" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Reduce image size with clear results." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToOrganizePagesCommand}"><StackPanel Spacing="7"><TextBlock Text="Organize pages" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Reorder, rotate and remove pages." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToProtectCommand}"><StackPanel Spacing="7"><TextBlock Text="Protect PDF" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Require a password to open a PDF." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToUnlockCommand}"><StackPanel Spacing="7"><TextBlock Text="Unlock PDF" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Remove a password you know." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToConvertExportCommand}"><StackPanel Spacing="7"><TextBlock Text="Convert / export" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Create PDFs, images and text exports." Classes="helper" /></StackPanel></Button>
                <Button Classes="toolCard" Command="{Binding GoToAboutCommand}"><StackPanel Spacing="7"><TextBlock Text="About PDFToys" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Version, licenses and project information." Classes="helper" /></StackPanel></Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
